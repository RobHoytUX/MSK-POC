VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Keyword tree API base (Fastapi). Defaults to http://localhost:8000 when unset.
# Local dev (frontend/.env.local):
#   VITE_API_URL=http://localhost:8000
#
# Vercel (required for keyword tree + PubMed in production):
# 1. Deploy your FastAPI app and note its public origin, e.g. https://xxxx.execute-api.us-east-2.amazonaws.com
# 2. Vercel → your project → Settings → Environment Variables
# 3. Add VITE_API_URL = that https origin (no trailing slash). Apply to Production and Preview.
# 4. Redeploy (Env vars are baked in at *build* time for Vite).
# Do not set this to your Vercel app URL or S3 website URL — only the API host.

# Inject fake Kw leaves when the keyword-tree API has no rows (UI demo only).
# Leave unset so keywords come only from Postgres via the API.
# VITE_DEMO_KEYWORD_LEAVES=true

# Clinical Intelligence backend (timeline + /chat). Defaults to demo host when unset.
# Production browsers cannot call this HTTP URL directly from an HTTPS Vercel app (mixed content).
# When VITE_API_URL is https, the frontend uses /api/clinical/* on the NeuroNode API instead.
VITE_CLINICAL_INTELLIGENCE_URL=http://18.191.159.27:8000
